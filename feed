      <title>Askerî Yargıtay Daireler Kurulu (1980)</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-askeri-yargitay-daireler-kurulu-zekeriya-onge.html</link>
      <guid isPermaLink="false">tarih-a73bc270ef18c3bc81fd</guid>
      <pubDate>Fri, 20 Nov 2026 11:50:43 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Olay</category>
