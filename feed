      <title>2022 FIFA Dünya Kupası başladı (2022) – Tarihte Bugün</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-2022-fifa-dunya-kupasi-basladi.html</link>
      <guid isPermaLink="false">tarih-17e8c359301af070a479</guid>
      <pubDate>Fri, 20 Nov 2026 11:51:09 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
