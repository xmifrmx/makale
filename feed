      <title>June Furlong: Hayatı, Mirası ve Tarihteki Etkisi (2020)</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-june-furlong.html</link>
      <guid isPermaLink="false">tarih-c630e92f35f199e16783</guid>
      <pubDate>Fri, 20 Nov 2026 11:50:51 +0000</pubDate>
