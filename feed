      <title>Fidelio (1805) – Tarihte Bugün</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-fidelio.html</link>
      <guid isPermaLink="false">tarih-d046523ed8eb5c22f87a</guid>
      <pubDate>Fri, 20 Nov 2026 11:51:53 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Olay</category>
      <category>Fidelio</category>
