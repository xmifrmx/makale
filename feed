      <title>Teoman Kimdir? Hayatı, Eserleri ve Tarihteki Yeri</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-teoman.html</link>
      <guid isPermaLink="false">tarih-f06694e0ec035b3975a0</guid>
      <pubDate>Fri, 20 Nov 2026 11:53:58 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Doğum</category>
