      <title>Eimuntas Nekrošius: Hayatı, Mirası ve Tarihteki Etkisi (2018)</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-eimuntas-nekrosius.html</link>
      <guid isPermaLink="false">tarih-9d0f87247b79f0dbcae2</guid>
      <pubDate>Fri, 20 Nov 2026 11:52:13 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Ölüm</category>
      <category>Eimuntas Nekrošius</category>
      <category>21. yüzyıl</category>
