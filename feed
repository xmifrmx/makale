      <title>Kaliforniya (1993) – Tarihte Bugün</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-kaliforniya.html</link>
      <guid isPermaLink="false">tarih-e9a8fd5dbbe64b79ac12</guid>
      <pubDate>Fri, 20 Nov 2026 11:51:16 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Olay</category>
      <category>Kaliforniya</category>
