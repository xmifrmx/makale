      <title>David Dacko: Hayatı, Mirası ve Tarihteki Etkisi (2003)</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-david-dacko.html</link>
      <guid isPermaLink="false">tarih-c0d97fb3426342cca2a8</guid>
      <pubDate>Fri, 20 Nov 2026 11:53:35 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Ölüm</category>
