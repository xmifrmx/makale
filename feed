      <title>Halid Bešlić Kimdir? Hayatı, Eserleri ve Tarihteki Yeri</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-halid-beslic.html</link>
      <guid isPermaLink="false">tarih-b2bbf4863c87a9de6293</guid>
      <pubDate>Fri, 20 Nov 2026 11:51:22 +0000</pubDate>
