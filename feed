      <content:encoded><![CDATA[<div class="separator" style="clear: both; text-align: center;"><img alt="Otto von Guericke ile ilgili görsel" border="0" height="902" src="https://upload.wikimedia.org/wikipedia/commons/f/f8/Otto-von-Guericke-TS.jpg?utm_source=tr.wikipedia.org&amp;utm_campaign=api&amp;utm_content=thumbnail_unscaled" style="max-width: 100%; height: auto;" width="834" /></div>
