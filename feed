      <title>Namık Tarancı, uğradığı silahlı saldırı sonucu öldü (1992)</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-namik-taranci-ugradigi-silahli-saldiri-sonucu.html</link>
      <guid isPermaLink="false">tarih-2752199b3eadef293c9b</guid>
      <pubDate>Fri, 20 Nov 2026 11:50:54 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Olay</category>
      <category>Namık Tarancı</category>
      <category>20. yüzyıl</category>
      <category>Tarihte Bugün</category>
