      <guid isPermaLink="false">tarih-0ed6d4461e90ee08089e</guid>
      <pubDate>Fri, 20 Nov 2026 11:50:48 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Olay</category>
      <category>Dünya Halter Şampiyonası</category>
      <category>20. yüzyıl</category>
