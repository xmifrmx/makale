      <title>Percy Cox Kimdir? Hayatı, Eserleri ve Tarihteki Yeri</title>
      <link>https://xmifrmx.github.io/makale/makale/2026-11-20-percy-cox.html</link>
      <guid isPermaLink="false">tarih-faefea7a1d3320c3b330</guid>
      <pubDate>Fri, 20 Nov 2026 11:54:10 +0000</pubDate>
      <dc:creator>Tarihte Bugün</dc:creator>
      <category>Doğum</category>
      <category>Percy Cox</category>
      <category>19. yüzyıl</category>
      <category>Tarihte Bugün</category>
